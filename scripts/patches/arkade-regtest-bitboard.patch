@@ -0,0 +1,132 @@
+// Bark server bring-up. The container is defined by the parent compose override
+// under profile `bark`. A listening port is not enough: the round wallet must
+// hold trusted coins before start returns.
+import net from 'node:net';
+import { env } from '../env.mjs';
+import { log, fail } from '../log.mjs';
+import { sleep } from '../wait.mjs';
+import { faucet, mine } from '../chain.mjs';
+import { dockerExec, resolveContainerName } from '../proc.mjs';
+
+const ROUND_WALLET_FUND_BTC = '1';
+const TRUSTED_BALANCE_MINE_LIMIT = 12;
+const POLL_MS = 2000;
+const DEFAULT_TIMEOUT_MS = 120_000;
+
+function healthTimeoutMs() {
+  const parsed = Number(env('BARK_REGTEST_HEALTH_TIMEOUT_MS', ''));
+  if (Number.isFinite(parsed) && parsed > 0) return parsed;
+  return process.env.CI ? 180_000 : DEFAULT_TIMEOUT_MS;
+}
+
+function captaindPort() {
+  return Number(env('CAPTAIND_PORT', '3535'));
+}
+
+function portAcceptsConnection(port) {
+  return new Promise((resolve) => {
+    const socket = net.connect({ host: '127.0.0.1', port });
+    const finish = (open) => {
+      socket.destroy();
+      resolve(open);
+    };
+    socket.setTimeout(2000);
+    socket.once('connect', () => finish(true));
+    socket.once('timeout', () => finish(false));
+    socket.once('error', () => finish(false));
+  });
+}
+
+function readRoundWallet() {
+  const result = dockerExec('captaind', ['captaind', 'rpc', 'wallet'], { capture: true });
+  if (result.code !== 0) return null;
+  try {
+    const rounds = JSON.parse(result.stdout)?.rounds;
+    if (rounds == null || typeof rounds.address !== 'string' || rounds.address.length === 0) {
+      return null;
+    }
+    const trustedBalanceSats = Number(rounds.trusted_balance);
+    const untrustedBalanceSats = Number(rounds.untrusted_balance);
+    const totalBalanceSats = Number(rounds.total_balance);
+    if (!Number.isFinite(trustedBalanceSats)) return null;
+    const confirmedUtxoCount = Array.isArray(rounds.confirmed_utxos)
+      ? rounds.confirmed_utxos.length
+      : 0;
+    return {
+      address: rounds.address,
+      trustedBalanceSats,
+      untrustedBalanceSats: Number.isFinite(untrustedBalanceSats) ? untrustedBalanceSats : 0,
+      totalBalanceSats: Number.isFinite(totalBalanceSats) ? totalBalanceSats : 0,
+      confirmedUtxoCount,
+    };
+  } catch {
+    return null;
+  }
+}
+
+function roundWalletHasCoins(wallet) {
+  return (
+    wallet.totalBalanceSats > 0 ||
+    wallet.untrustedBalanceSats > 0 ||
+    wallet.confirmedUtxoCount > 0
+  );
+}
+
+async function waitForRoundWallet(deadline, timeoutMs) {
+  const containerName = resolveContainerName('captaind');
+  while (Date.now() < deadline) {
+    if (await portAcceptsConnection(captaindPort())) {
+      const wallet = readRoundWallet();
+      if (wallet != null) return wallet;
+    }
+    await sleep(POLL_MS);
+  }
+  fail(
+    `captaind round wallet did not answer within ${timeoutMs}ms (${containerName}). ` +
+      'Profile bark starts captaind only when the parent compose override is present.',
+  );
+}
+
+// One confirmation leaves the coin untrusted. Mine until captaind reports
+// trusted sats, matching the parent bark-regtest health check.
+async function waitForTrustedBalance(deadline) {
+  let minesSinceCoins = 0;
+  while (Date.now() < deadline) {
+    const funded = readRoundWallet();
+    if (funded != null && funded.trustedBalanceSats > 0) {
+      log(`captaind round wallet balance: ${funded.trustedBalanceSats} sats`);
+      return;
+    }
+    if (funded != null && roundWalletHasCoins(funded)) {
+      if (minesSinceCoins >= TRUSTED_BALANCE_MINE_LIMIT) {
+        fail(
+          `captaind round wallet has coins but trusted_balance stayed 0 after ${minesSinceCoins} extra blocks`,
+        );
+      }
+      if (!(await mine(1))) fail('captaind round wallet mine failed');
+      minesSinceCoins += 1;
+    }
+    await sleep(POLL_MS);
+  }
+  fail('captaind round wallet stayed unfunded');
+}
+
+export async function setupCaptaind() {
+  const timeoutMs = healthTimeoutMs();
+  const wallet = await waitForRoundWallet(Date.now() + timeoutMs, timeoutMs);
+  if (wallet.trustedBalanceSats > 0) {
+    log(
+      `captaind round wallet already funded (${wallet.trustedBalanceSats} sats at ${wallet.address})`,
+    );
+    return;
+  }
+
+  if (!roundWalletHasCoins(wallet)) {
+    log(`Funding captaind round wallet at ${wallet.address} (${ROUND_WALLET_FUND_BTC} BTC)...`);
+    if (!(await faucet(wallet.address, ROUND_WALLET_FUND_BTC, { confirm: true }))) {
+      fail(`faucet of captaind round wallet at ${wallet.address} failed`);
+    }
+  }
+  // Fresh budget. Boot can consume the first timeout; trusted balance still needs mines.
+  await waitForTrustedBalance(Date.now() + timeoutMs);
+}
