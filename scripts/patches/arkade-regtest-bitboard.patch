diff --git a/lib/esplora-diagnostics.mjs b/lib/esplora-diagnostics.mjs
new file mode 100644
index 0000000..a670e8b
--- /dev/null
+++ b/lib/esplora-diagnostics.mjs
@@ -0,0 +1,129 @@
+// Esplora tx probes for manual regtest debugging.
+//   node regtest.mjs esplora-tip
+//   node regtest.mjs esplora-tx <txid> [txid...]
+// Call after loadEnv(), so MEMPOOL_WEB_PORT matches the published gateway.
+import { env } from './env.mjs';
+import { fetchText } from './wait.mjs';
+import { log, fail } from './log.mjs';
+
+function esploraApiBase() {
+  return `http://localhost:${env('MEMPOOL_WEB_PORT', '3000')}/api`;
+}
+
+async function fetchJson(url) {
+  const { ok, status, text } = await fetchText(url);
+  if (!ok) {
+    return { ok: false, status, text };
+  }
+  try {
+    return { ok: true, status, body: JSON.parse(text) };
+  } catch {
+    return { ok: true, status, body: text };
+  }
+}
+
+async function fetchChainTipHeight() {
+  const { ok, body } = await fetchJson(`${esploraApiBase()}/blocks/tip/height`);
+  if (!ok) return null;
+  if (typeof body === 'number') return body;
+  if (typeof body === 'string' && /^\d+$/.test(body.trim())) {
+    return Number.parseInt(body.trim(), 10);
+  }
+  return null;
+}
+
+function confirmationsFromBlockHeight(blockHeight, tipHeight) {
+  if (typeof blockHeight !== 'number' || tipHeight == null) return null;
+  return Math.max(0, tipHeight - blockHeight + 1);
+}
+
+// Null when this endpoint did not answer, or when a confirmed status has no
+// block height to count from. Unconfirmed is 0.
+function confirmationsFromStatus(probe, tipHeight) {
+  if (!probe.ok || probe.body == null || typeof probe.body !== 'object') return null;
+  const status = probe.body;
+  if (status.confirmed !== true) return 0;
+  return confirmationsFromBlockHeight(status.block_height, tipHeight);
+}
+
+function responseSnippet(probe) {
+  const raw = probe.text ?? (typeof probe.body === 'string' ? probe.body : JSON.stringify(probe.body ?? ''));
+  return String(raw).slice(0, 120);
+}
+
+function logConfirmationDisagreement(sources) {
+  const known = sources.filter((source) => source.confirmations != null);
+  if (known.length < 2) return;
+  const baseline = known[0].confirmations;
+  if (known.every((source) => source.confirmations === baseline)) return;
+  const detail = known.map((source) => `${source.name}=${source.confirmations}`).join(' ');
+  log(`  confirmation sources disagree: ${detail}`);
+}
+
+async function probeTx(txid, tipHeight) {
+  const api = esploraApiBase();
+  const statusRes = await fetchJson(`${api}/tx/${txid}/status`);
+  const rawRes = await fetchText(`${api}/tx/${txid}/raw`);
+  const merkleRes = await fetchJson(`${api}/tx/${txid}/merkle-proof`);
+  const txRes = await fetchJson(`${api}/tx/${txid}`);
+
+  const status = statusRes.ok && statusRes.body != null && typeof statusRes.body === 'object'
+    ? statusRes.body
+    : null;
+  const txJsonStatus = txRes.ok && txRes.body?.status != null && typeof txRes.body.status === 'object'
+    ? txRes.body.status
+    : null;
+  const merkleHeight = merkleRes.ok && typeof merkleRes.body?.block_height === 'number'
+    ? merkleRes.body.block_height
+    : null;
+
+  const statusConfirmations = confirmationsFromStatus(
+    { ok: statusRes.ok, body: status },
+    tipHeight,
+  );
+  const txConfirmations = confirmationsFromStatus(
+    { ok: txRes.ok, body: txJsonStatus },
+    tipHeight,
+  );
+  const merkleConfirmations = confirmationsFromBlockHeight(merkleHeight, tipHeight);
+
+  log(`txid ${txid}`);
+  log(
+    `  /status: http=${statusRes.status} confirmed=${status == null ? '(missing)' : status.confirmed === true} block_height=${status?.block_height ?? '(missing)'} confirmations=${statusConfirmations ?? 'unknown'}`,
+  );
+  log(`  /raw: http=${rawRes.status} available=${rawRes.ok}`);
+  if (merkleHeight != null) {
+    log(
+      `  /merkle-proof: block_height=${merkleHeight} confirmations=${merkleConfirmations ?? 'unknown'}`,
+    );
+  } else {
+    log(`  /merkle-proof: http=${merkleRes.status} ${responseSnippet(merkleRes)}`.trim());
+  }
+  log(
+    `  /tx JSON: http=${txRes.status} confirmed=${txJsonStatus == null ? '(missing)' : txJsonStatus.confirmed === true} block_height=${txJsonStatus?.block_height ?? '(missing)'} confirmations=${txConfirmations ?? 'unknown'}`,
+  );
+  logConfirmationDisagreement([
+    { name: 'status', confirmations: statusConfirmations },
+    { name: 'tx', confirmations: txConfirmations },
+    { name: 'merkle', confirmations: merkleConfirmations },
+  ]);
+}
+
+export async function esploraTip() {
+  const api = esploraApiBase();
+  const tip = await fetchChainTipHeight();
+  log(`Esplora ${api}`);
+  log(`chain_tip_height=${tip ?? 'unknown'}`);
+}
+
+export async function esploraTx(txids) {
+  if (!txids || txids.length === 0) {
+    fail('usage: node regtest.mjs esplora-tx <txid> [txid...]');
+  }
+  const api = esploraApiBase();
+  const tip = await fetchChainTipHeight();
+  log(`Esplora ${api} chain_tip_height=${tip ?? 'unknown'}`);
+  for (const txid of txids) {
+    await probeTx(txid, tip);
+  }
+}
