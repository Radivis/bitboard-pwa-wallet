--- /dev/null
+++ b/lib/esplora-diagnostics.mjs
@@ -0,0 +1,99 @@
+// Esplora tx probes for manual regtest debugging.
+//   node regtest.mjs esplora-tip
+//   node regtest.mjs esplora-tx <txid> [txid...]
+import { fetchText } from './wait.mjs';
+import { log } from './log.mjs';
+
+const ESPLORA_API = 'http://localhost:7030/api';
+
+async function fetchJson(url) {
+  const { ok, status, text } = await fetchText(url);
+  if (!ok) {
+    return { ok: false, status, text };
+  }
+  try {
+    return { ok: true, status, body: JSON.parse(text) };
+  } catch {
+    return { ok: true, status, body: text };
+  }
+}
+
+async function fetchChainTipHeight() {
+  const { ok, status, body } = await fetchJson(`${ESPLORA_API}/blocks/tip/height`);
+  if (!ok) {
+    return null;
+  }
+  if (typeof body === 'number') {
+    return body;
+  }
+  if (typeof body === 'string' && /^\d+$/.test(body.trim())) {
+    return Number.parseInt(body.trim(), 10);
+  }
+  return null;
+}
+
+function confirmationsFromStatus(status, tipHeight) {
+  if (status?.confirmed !== true) {
+    return 0;
+  }
+  if (status.block_height != null && tipHeight != null) {
+    return Math.max(0, tipHeight - status.block_height + 1);
+  }
+  return 1;
+}
+
+async function probeTx(txid, tipHeight) {
+  const statusRes = await fetchJson(`${ESPLORA_API}/tx/${txid}/status`);
+  const rawRes = await fetchText(`${ESPLORA_API}/tx/${txid}/raw`);
+  const merkleRes = await fetchJson(`${ESPLORA_API}/tx/${txid}/merkle-proof`);
+  const txRes = await fetchJson(`${ESPLORA_API}/tx/${txid}`);
+
+  const status = statusRes.ok ? statusRes.body : null;
+  const txJsonStatus = txRes.ok ? txRes.body?.status : null;
+  const merkleHeight =
+    merkleRes.ok && typeof merkleRes.body?.block_height === 'number'
+      ? merkleRes.body.block_height
+      : null;
+
+  let inferredConfirmations = 0;
+  if (merkleHeight != null && tipHeight != null) {
+    inferredConfirmations = Math.max(0, tipHeight - merkleHeight + 1);
+  } else {
+    inferredConfirmations = Math.max(
+      confirmationsFromStatus(status, tipHeight),
+      confirmationsFromStatus(txJsonStatus, tipHeight),
+    );
+  }
+
+  log(`txid ${txid}`);
+  log(`  inferred_confirmations=${inferredConfirmations}`);
+  log(
+    `  /status: http=${statusRes.status} confirmed=${status?.confirmed ?? false} block_height=${status?.block_height ?? '(missing)'}`,
+  );
+  log(`  /raw: http=${rawRes.status} available=${rawRes.ok}`);
+  if (merkleHeight != null) {
+    log(`  /merkle-proof: block_height=${merkleHeight}`);
+  } else {
+    log(`  /merkle-proof: http=${merkleRes.status} ${merkleRes.ok ? '' : merkleRes.text?.slice(0, 120) ?? ''}`.trim());
+  }
+  log(
+    `  /tx JSON: http=${txRes.status} confirmed=${txJsonStatus?.confirmed ?? false} block_height=${txJsonStatus?.block_height ?? '(missing)'}`,
+  );
+}
+
+export async function esploraTip() {
+  const tip = await fetchChainTipHeight();
+  log(`Esplora ${ESPLORA_API}`);
+  log(`chain_tip_height=${tip ?? 'unknown'}`);
+}
+
+export async function esploraTx(txids) {
+  if (txids.length === 0) {
+    throw new Error('usage: node regtest.mjs esplora-tx <txid> [txid...]');
+  }
+  const tip = await fetchChainTipHeight();
+  log(`Esplora ${ESPLORA_API} chain_tip_height=${tip ?? 'unknown'}`);
+  for (const txid of txids) {
+    await probeTx(txid, tip);
+  }
+}
